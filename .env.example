# Native Land Digital API Configuration
# Get your free API key at: https://api-docs.native-land.ca/get-and-use-your-api-key
#
# Instructions:
# 1. Copy this file to .env (in the same directory as pubspec.yaml)
# 2. Replace YOUR_API_KEY with your actual API key
# 3. The .env file is in .gitignore and won't be committed to version control
#
NATIVE_LAND_API_KEY=YOUR_API_KEY

