# Native Land API key configuration
#
# Copy this file to `.env` and replace YOUR_API_KEY_HERE with your real key.
# The `.env` file is already ignored by git, so the key stays out of the repo.
#
# Example:
# NATIVE_LAND_API_KEY=abc123def456ghi789jkl


# Map tiles for the observations map (3.6.0). The public OpenStreetMap servers don't allow app use,
# so use a keyed plan, for example MapTiler: https://api.maptiler.com/maps/outdoor-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# Restrict the key to the app in the provider's console. Leave empty to use OpenStreetMap in testing.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors

# Donations through Every.org (3.6.0). The donate button stays hidden until EVERYORG_NONPROFIT is set.
# EVERYORG_NONPROFIT is Rocky Mountain Wild's Every.org page name, for example rocky-mountain-wild.
# EVERYORG_WEBHOOK_TOKEN comes from partners@every.org.
EVERYORG_NONPROFIT=
EVERYORG_WEBHOOK_TOKEN=
