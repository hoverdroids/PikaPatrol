# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # BoringSSL-GRPC adds an invalid per-file compiler flag that clang parses as "-G" on Xcode 26.
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        next unless file.settings && file.settings['COMPILER_FLAGS']

        flags = file.settings['COMPILER_FLAGS']
        cleaned = flags.gsub('-GCC_WARN_INHIBIT_ALL_WARNINGS', '').squeeze(' ').strip
        file.settings['COMPILER_FLAGS'] = cleaned
      end
    end

    target.build_configurations.each do |config|
      # Force all pods to iOS 16.0 minimum (App Store requirement as of 2025/2026)
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 16.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end

      # On Apple Silicon, exclude x86_64 simulator for pod builds
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'

      # Fix firebase_* non-modular include warnings promoted to errors on newer Xcode
      config.build_settings['CLANG_WARN_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'NO'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

      # Remove malformed compiler flags if present
      %w[OTHER_CFLAGS OTHER_CPLUSPLUSFLAGS].each do |key|
        flags = config.build_settings[key]
        next if flags.nil?

        if flags.is_a?(String)
          config.build_settings[key] = flags.gsub('-GCC_WARN_INHIBIT_ALL_WARNINGS', '').squeeze(' ').strip
        elsif flags.is_a?(Array)
          config.build_settings[key] = flags.reject { |f| f.to_s.include?('-GCC_WARN_INHIBIT_ALL_WARNINGS') }
        end
      end

      # gRPC/BoringSSL: C++14 to stay ABI-compatible with abseil/FirebaseFirestore.
      # The missing-template-arg-list diagnostic must be downgraded (clang 16+ promotes it to error).
      if ['gRPC-Core', 'gRPC-C++', 'BoringSSL-GRPC'].include?(target.name)
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++14'
        cflags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
        flag = '-Wno-error=missing-template-arg-list-after-template-kw'
        if cflags.is_a?(String)
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{cflags} #{flag}".strip unless cflags.include?(flag)
        elsif cflags.is_a?(Array)
          cflags << flag unless cflags.include?(flag)
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cflags
        end
      end

      # abseil MUST compile as C++14 so absl::string_view stays its own type (not aliased to std::string_view).
      # FirebaseFirestore 10.x and gRPC-Core were compiled against that ABI; C++17 mode produces mangled-name
      # mismatches at link time because absl::string_view would become std::string_view.
      if target.name == 'abseil'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++14'
      end

      # permission_handler configuration
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        # 'PERMISSION_EVENTS=1',
        # 'PERMISSION_REMINDERS=1',
        # 'PERMISSION_CONTACTS=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        # 'PERMISSION_SPEECH_RECOGNIZER=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_LOCATION=1',
        # 'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_MEDIA_LIBRARY=1',
        # 'PERMISSION_SENSORS=1',
        # 'PERMISSION_BLUETOOTH=1',
        # 'PERMISSION_APP_TRACKING_TRANSPARENCY=1',
        # 'PERMISSION_CRITICAL_ALERTS=1'
      ]
    end
  end
end
